namespace Norscope.AskAI
{
    /// <summary>Phase 1 mock data only. No timing, UI, or scene object control.</summary>
    public sealed class MockAskAiService : IAskAiService
    {
        public const string DefaultTranscript =
            "What is wrong with this cooling fan?";

        public const string DefaultAnswer =
            "The cooling fan appears obstructed by dust. Power off the device before cleaning.";

        public string GetMockTranscript() => DefaultTranscript;

        public string GetMockAnswer() => DefaultAnswer;
    }
}
