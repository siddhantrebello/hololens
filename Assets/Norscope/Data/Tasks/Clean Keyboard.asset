--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a75e3b2a68aa1c24e9d7d15fde9e9bea, type: 3}
  m_Name: Clean Keyboard
  m_EditorClassIdentifier: 
  taskId: clean-keyboard
  displayName: Clean Keyboard
  description: Remove debris and sanitize the keys.
  icon: {fileID: 21300000, guid: 2deb64c5dd04087499331b4f3a029c93, type: 3}
  estimatedDuration: 15 min
  difficulty: 0
  category: Cleaning
  offlineAvailable: 1
  lastUpdated: ''
  isEnabled: 1
  steps:
  - stepTitle: Power Down
    instruction: Shut down the laptop and unplug it before cleaning.
    image: {fileID: 0}
    warning: 
    verification: 
  - stepTitle: Remove Loose Debris
    instruction: Turn the laptop upside down and gently shake, or use compressed
      air between the keys to dislodge crumbs and dust.
    image: {fileID: 0}
    warning: 
    verification: 
  - stepTitle: Clean the Keycaps
    instruction: Lightly dampen a microfiber cloth with isopropyl alcohol and wipe
      each keycap.
    image: {fileID: 0}
    warning: "Never spray liquid directly onto the keyboard \u2014 apply it to the
      cloth first."
    verification: 
  - stepTitle: Clean Between the Keys
    instruction: Use a soft brush or cotton swab to clean around the edges of each
      key.
    image: {fileID: 0}
    warning: 
    verification: 
  - stepTitle: Let Dry and Test
    instruction: Allow the keyboard to air dry fully before powering on, then test
      that every key registers correctly.
    image: {fileID: 0}
    warning: 
    verification: Every key should register once in a text field with no sticking
      or double inputs.
