--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a75e3b2a68aa1c24e9d7d15fde9e9bea, type: 3}
  m_Name: Clean Laptop Fan
  m_EditorClassIdentifier: 
  taskId: clean-laptop-fan
  displayName: Clean Laptop Fan
  description: Remove dust buildup from the cooling fan and vents.
  icon: {fileID: 21300000, guid: 2deb64c5dd04087499331b4f3a029c93, type: 3}
  estimatedDuration: 20 min
  difficulty: 0
  isEnabled: 1
  steps:
  - stepTitle: Power Down and Unplug
    instruction: Shut down the laptop completely and disconnect the AC adapter.
    image: {fileID: 0}
    warning: Never open the case while the laptop is powered or plugged in.
    verification: 
  - stepTitle: Remove the Back Panel
    instruction: Unscrew and lift off the bottom access panel to expose the cooling
      fan.
    image: {fileID: 0}
    warning: 
    verification: 
  - stepTitle: Loosen Dust with Compressed Air
    instruction: Hold the fan blades still with a toothpick and use short bursts
      of compressed air to dislodge dust.
    image: {fileID: 0}
    warning: "Do not let the fan spin freely under air pressure \u2014 this can generate
      damaging voltage."
    verification: 
  - stepTitle: Wipe Down the Vents
    instruction: Use a dry microfiber cloth to remove loosened dust from the vent
      openings.
    image: {fileID: 0}
    warning: 
    verification: 
  - stepTitle: Reassemble and Test
    instruction: Replace the back panel, power on the laptop, and confirm the fan
      spins freely and quietly.
    image: {fileID: 0}
    warning: 
    verification: Fan noise should be noticeably reduced and airflow from the vent
      should feel stronger.
