%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a75e3b2a68aa1c24e9d7d15fde9e9bea, type: 3}
  m_Name: Upgrade SSD
  m_EditorClassIdentifier: 
  taskId: upgrade-ssd
  displayName: Upgrade SSD
  description: Replace the storage drive with a higher-capacity SSD.
  icon: {fileID: 21300000, guid: 2deb64c5dd04087499331b4f3a029c93, type: 3}
  estimatedDuration: 30 min
  difficulty: 1
  isEnabled: 1
  steps:
  - stepTitle: Back Up Your Data
    instruction: Back up all important files or create a full disk image before starting.
    image: {fileID: 0}
    warning: This procedure will not preserve existing data on the drive unless you
      clone it first.
    verification: 
  - stepTitle: Power Down and Open the Case
    instruction: Shut down, unplug, and remove the back panel to access the storage
      bay.
    image: {fileID: 0}
    warning: 
    verification: 
  - stepTitle: Remove the Old Drive
    instruction: Unscrew and gently slide out the existing SSD or HDD from its slot
      or cable.
    image: {fileID: 0}
    warning: 
    verification: 
  - stepTitle: Install the New SSD
    instruction: Insert the new SSD into the same slot at a slight angle, then press
      down and secure the mounting screw.
    image: {fileID: 0}
    warning: "Ensure the connector is fully seated before screwing down \u2014 a
      loose connection can prevent boot."
    verification: 
  - stepTitle: Boot and Initialize
    instruction: Power on, enter BIOS to confirm the drive is detected, then install
      or restore the operating system.
    image: {fileID: 0}
    warning: 
    verification: New SSD should appear in BIOS/OS disk management with its full
      rated capacity.
